# ============================================================
# NetOne Lead Automation — Environment Configuration (EXAMPLE)
# Copy to `.env` and fill real values. NEVER commit the real .env.
# ============================================================
#
# PORTS: everything defaults to the 47xx range (unique/uncommon) so this
# stack won't collide with other demos/services on a shared host. Change any
# of POSTGRES_PORT / BACKEND_PORT / WHATSAPP_PORT / FRONTEND_PORT below if
# they still collide, and update NEXT_PUBLIC_BACKEND_URL /
# BACKEND_WEBHOOK_URL / DATABASE_URL to match.

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=netone
POSTGRES_PASSWORD=change_me
POSTGRES_DB=netone_leads
POSTGRES_HOST=postgres
# Host-exposed port only (container-internal port is always 5432).
POSTGRES_PORT=4705
# Full URL used by the backend (compose networking uses the internal port).
# For local (non-Docker) dev, point at the host port above instead:
# postgresql://netone:change_me@localhost:4705/netone_leads
DATABASE_URL=postgresql://netone:change_me@postgres:5432/netone_leads

# ── Backend ────────────────────────────────────────────────
BACKEND_PORT=4702
# Shared secret the WhatsApp service uses when posting to the backend webhook.
WEBHOOK_SHARED_SECRET=replace_with_a_random_string

# ── WhatsApp service (Baileys) ─────────────────────────────
WHATSAPP_PORT=4703
# Where the WhatsApp service forwards normalized inbound messages.
BACKEND_WEBHOOK_URL=http://backend:4702/api/channels/whatsapp/webhook

# ── AI: DeepSeek (primary) → Gemini (fallback) ─────────────
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Bitrix24 (REAL CRM) ────────────────────────────────────
# Full inbound webhook base URL incl. user id + token, trailing slash:
# https://<portal>.bitrix24.com/rest/<user>/<token>/
BITRIX24_WEBHOOK_URL=
# Optional: Bitrix user id to assign leads to (sales rep). Blank = portal default.
BITRIX24_ASSIGNED_BY_ID=
# Portal base URL (no trailing path), used to build clickable "open in CRM"
# links in the dashboard. Public/safe — no token. e.g. https://<portal>.bitrix24.com
NEXT_PUBLIC_BITRIX24_PORTAL_URL=

# ── Facebook Messenger (REAL channel) ──────────────────────
# From your Meta App's Messenger settings, once a Page is connected.
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Any random string you invent — must match exactly what you enter in the
# Meta webhook subscription's "Verify Token" field.
FACEBOOK_VERIFY_TOKEN=

# ── Firebase (real-time layer) ─────────────────────────────
# Client config is public by design (safe in the browser bundle).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Backend Admin SDK: path to the service-account JSON (git-ignored). NEVER commit it.
FIREBASE_ADMIN_CREDENTIALS=./secrets/firebase-admin.json
FIREBASE_PROJECT_ID=

# ── Clerk (dashboard auth) ─────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional demo bypass: set to true to open the console without Clerk sign-in.
DISABLE_AUTH=

# ── Autonomous auto-reply ──────────────────────────────────
# Default state of the WhatsApp auto-reply agent (toggled live in the dashboard).
AUTO_REPLY_DEFAULT=true

# ── Frontend ───────────────────────────────────────────────
# Browser-visible base URL of the backend (SSE + REST). Server-only secrets
# must NOT be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4702
FRONTEND_PORT=4701
